<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>benjagest</artifactId>
    <groupId>com.benjagest</groupId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>gestor-navegador</artifactId>
  <name>BENJAGEST Gestor-Navegador</name>
  <description>Navegador embebido (Chromium real vía JCEF) para AEAT/DEHú/SS RED/SILTRA
        con el certificado del cliente. Módulo SEPARADO y NO modular (sin module-info)
        a propósito: JCEF trae jars con nombres no válidos para módulos automáticos
        de JPMS (p.ej. jcef-api-...+cef-...+chromium-...jar), por eso no se puede
        integrar dentro del módulo `ui` (modular). Se lanza como PROCESO/ventana
        aparte desde la app JavaFX (decisión Benjamin: "ventana aparte por cliente").</description>
  <build>
    <finalName>gestor-navegador</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.benjagest.navegador.BrowserLauncher</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
